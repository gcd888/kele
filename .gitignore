# 依赖与构建产物
node_modules/
dist/
unpackage/

# 本地凭证与环境（Cloudflare R2 / Wrangler）
.dev.vars
.env
.wrangler/

# IDE / 工具目录
.idea/
.trae/
.DS_Store
.npm-cache/
*.local

# 本地草稿
demo/

# spider 源码工程编译产物与桌面测试类（不入库）
src/main/*/build/
src/main/*/test/

# 第三方参考蓝本与抓包测试数据（不入库）
case/

# 线路配置发布目录：凭证与打包产物不入库
src/guoju-api/r2.env
src/guoju-api/*.zip
*.log

# ---- R2 发布凭据（Cloudflare API Token，任意层级防泄漏；java/js 发布脚本共用） ----
r2.env

# ---- 接口包产物（GJZ1 加密包，可由 guoju-api/*/pack.py 重建，体积大不入库） ----
src/guoju-api/java/*.zip
src/guoju-api/js/*.zip

# ---- spider 桌面测试的设备身份存档（本地状态，非配置） ----
*_device.json

# ---- ysc 第三方源 token 配置 ----
src/ysc/diy/短剧狗/json/tokenm.json

# ---- js 编译混淆依赖锁与临时产物 ----
src/main/js/**/*.plain.tmp
